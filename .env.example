# AplicaÃ§Ã£o
APP_NAME=InboxGuard AI
APP_VERSION=0.3.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
DATABASE_STARTUP_CHECK=true
API_PORT=8000

# PostgreSQL
POSTGRES_DB=inboxguard
POSTGRES_USER=inboxguard
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://inboxguard:change-this-local-password@localhost:5432/inboxguard
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Google OAuth e Gmail â€” obrigatÃ³rios na Fase 2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_OAUTH_SCOPES=["https://www.googleapis.com/auth/gmail.readonly"]
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
GOOGLE_ALLOW_INSECURE_HTTP=true
TOKEN_ENCRYPTION_KEY=
GMAIL_SYNC_MAX_MESSAGES=50
GMAIL_STORE_BODY_TEXT=false
GMAIL_RETRY_ATTEMPTS=3

# ClassificaÃ§Ã£o da Fase 3
# ClassificaÃ§Ã£o da Fase 3
# Valores aceitos: disabled, openai ou groq
AI_PROVIDER=disabled
AI_DETERMINISTIC_THRESHOLD=0.88
AI_TIMEOUT_SECONDS=30
AI_RETRY_ATTEMPTS=3
AI_MAX_INPUT_CHARACTERS=12000
AI_PROMPT_VERSION=email-classification-v2

OPENAI_MODEL=gpt-5-mini
OPENAI_API_KEY=

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# Reservadas para fases posteriores
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=[]
TELEGRAM_ALLOWED_CHAT_IDS=[]
TELEGRAM_WEBHOOK_SECRET=
